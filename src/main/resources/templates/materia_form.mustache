<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{accion}} Materia</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px; }
        .form-group input, .form-group textarea {
            width:100%; padding:10px 14px; border:1.5px solid #d1d5db; border-radius:8px;
            font-size:14px; outline:none; transition: border-color 0.2s; box-sizing:border-box;
        }
        .form-group input:focus, .form-group textarea:focus { border-color:#2563eb; }
        .form-group input[readonly] { background:#f9fafb; color:#6b7280; cursor:not-allowed; }
        .form-group textarea { resize:vertical; min-height:90px; }
        .hint { font-size:11.5px; color:#6b7280; margin-top:4px; }
        .btn-primary { background:#2563eb;color:#fff;padding:10px 22px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer; }
        .btn-secondary { background:#f1f5f9;color:#374151;padding:10px 18px;border:1px solid #e2e8f0;border-radius:8px;font-size:14px;text-decoration:none;display:inline-block; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-book-open"></i></div>
            <div>
                <h1>{{accion}} Materia</h1>
                <span class="role-badge">Módulo B.2 — Oferta Académica</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/admin/materias" class="logout-btn">← Volver</a>
        </div>
    </div>

    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <div class="admin-section" style="max-width:560px;">
        <form action="{{formAction}}" method="post" id="materiaForm">

            {{#esEdicion}}
            <div class="form-group">
                <label>Código de materia</label>
                <input type="text" value="{{codigo}}" readonly>
                <div class="hint">El código no puede modificarse una vez creado (RN-03).</div>
            </div>
            {{/esEdicion}}

            {{^esEdicion}}
            <div class="form-group">
                <label for="codigo">Código de materia *</label>
                <input type="text" id="codigo" name="codigo" placeholder="Ej: ANA-I, PROG-II, FIS"
                       maxlength="20" required style="text-transform:uppercase;" value="{{codigo}}">
                <div class="hint">Solo letras, números y guion medio. Único e inmutable. Ej: ANA-I, PROG-II.</div>
            </div>
            {{/esEdicion}}

            <div class="form-group">
                <label for="nombre">Nombre de la materia *</label>
                <input type="text" id="nombre" name="nombre"
                       placeholder="Ej: Análisis Matemático I"
                       maxlength="200" required value="{{nombre}}">
                <div class="hint">Debe ser único en el sistema (sin distinción de mayúsculas).</div>
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción (opcional)</label>
                <textarea id="descripcion" name="descripcion"
                          placeholder="Descripción de la materia..." maxlength="1000">{{descripcion}}</textarea>
                <div class="hint">Máximo 1000 caracteres.</div>
            </div>

            <div style="display:flex;gap:12px;align-items:center;margin-top:24px;">
                <button type="submit" class="btn-primary">{{accion}} materia</button>
                <a href="/admin/materias" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>

</div>
<script>
    var codigoInput = document.getElementById('codigo');
    if (codigoInput) {
        codigoInput.addEventListener('input', function() {
            this.value = this.value.toUpperCase().replace(/[^A-Z0-9\-]/g, '');
        });
    }
</script>
</body>
</html>
