<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{nombre}} — Detalle</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .badge-activa   { background:#d1fae5;color:#065f46;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .badge-inactiva { background:#fee2e2;color:#991b1b;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .btn { padding:7px 16px;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;border:none;display:inline-block;text-decoration:none; }
        .btn-primary   { background:#2563eb;color:#fff; }
        .btn-success   { background:#059669;color:#fff; }
        .btn-warning   { background:#d97706;color:#fff; }
        .btn-danger    { background:#dc2626;color:#fff; }
        .btn-secondary { background:#f1f5f9;color:#374151;border:1px solid #e2e8f0; }
        .info-row  { display:flex;gap:8px;margin-bottom:8px;font-size:14px; }
        .info-label{ font-weight:600;color:#374151;min-width:120px; }
        .info-val  { color:#6b7280; }
        .warn-box  { background:#fffbeb;border:1px solid #fbbf24;color:#92400e;padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px; }
        table.asoc { width:100%;border-collapse:collapse;margin-top:12px; }
        table.asoc th { text-align:left;padding:9px 14px;background:#f8fafc;border-bottom:2px solid #e2e8f0;font-size:13px; }
        table.asoc td { padding:9px 14px;border-bottom:1px solid #f1f5f9;font-size:13px;vertical-align:middle; }
        .actions-cell { display:flex;gap:6px;flex-wrap:wrap; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-book-open"></i></div>
            <div>
                <h1>{{nombre}}</h1>
                <span class="role-badge">Materia · {{codigo}}</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/admin/materias" class="logout-btn">← Volver</a>
        </div>
    </div>

    {{#successMessage}}
    <div style="background:#d1fae5;color:#065f46;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{successMessage}}</div>
    {{/successMessage}}
    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <!-- Datos de la materia -->
    <div class="admin-section">
        <p class="section-title">Información</p>
        <div class="info-row"><span class="info-label">Código:</span><span class="info-val">{{codigo}}</span></div>
        <div class="info-row"><span class="info-label">Nombre:</span><span class="info-val">{{nombre}}</span></div>
        <div class="info-row">
            <span class="info-label">Descripción:</span>
            <span class="info-val">{{#descripcion}}{{descripcion}}{{/descripcion}}{{^descripcion}}—{{/descripcion}}</span>
        </div>
        <div class="info-row">
            <span class="info-label">Estado:</span>
            <span class="info-val">
                {{#activa}}<span class="badge-activa">Activa</span>{{/activa}}
                {{^activa}}<span class="badge-inactiva">Inactiva</span>{{/activa}}
            </span>
        </div>

        <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;">
            <a href="/admin/materias/{{id}}/editar" class="btn btn-primary">Editar</a>
            {{#activa}}
            <form action="/admin/materias/{{id}}/desactivar" method="post" style="display:inline;">
                <button type="submit" class="btn btn-danger"
                    onclick="return confirm('¿Desactivar esta materia? Continuará habiendo asociaciones activas vigentes si existen.')">
                    Desactivar
                </button>
            </form>
            {{/activa}}
            {{^activa}}
            <form action="/admin/materias/{{id}}/reactivar" method="post" style="display:inline;">
                <button type="submit" class="btn btn-success"
                    onclick="return confirm('¿Reactivar esta materia? Las asociaciones previas no se reactivan automáticamente.')">
                    Reactivar
                </button>
            </form>
            {{/activa}}
        </div>
    </div>

    <!-- Asociaciones a planes -->
    <div class="admin-section">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
            <p class="section-title" style="margin:0;">Asociaciones a Planes de Estudio</p>
            {{#activa}}
            <a href="/admin/materias/{{id}}/planes/nueva" class="btn btn-primary" style="font-size:13px;">+ Asociar a Plan</a>
            {{/activa}}
        </div>

        <table class="asoc">
            <thead>
                <tr>
                    <th>Carrera</th>
                    <th>Plan</th>
                    <th>Año en plan</th>
                    <th>Cuatrimestre</th>
                    <th>Carga horaria</th>
                    <th>Carácter</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#asociaciones}}
                <tr>
                    <td><strong>{{carreraCodigo}}</strong> {{carreraNombre}}</td>
                    <td>Plan {{anioVigencia}}</td>
                    <td style="color:#6b7280;">Año {{anioPlan}}</td>
                    <td style="color:#6b7280;">{{cuatrimestreLabel}}</td>
                    <td style="color:#6b7280;">{{cargaHoraria}} h/sem</td>
                    <td style="color:#6b7280;">{{caracterLabel}}</td>
                    <td>
                        {{#activa}}<span class="badge-activa">Activa</span>{{/activa}}
                        {{^activa}}<span class="badge-inactiva">Inactiva</span>{{/activa}}
                    </td>
                    <td>
                        <div class="actions-cell">
                            {{#activa}}
                            <a href="/admin/materias/{{materiaId}}/planes/{{id}}/editar" class="btn btn-secondary">Editar</a>
                            <form action="/admin/materias/{{materiaId}}/planes/{{id}}/desactivar" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('¿Desactivar esta asociación? Solo es posible si no existen cursadas registradas.')">
                                    Desactivar
                                </button>
                            </form>
                            {{/activa}}
                            {{^activa}}
                            <span style="color:#9ca3af;font-size:12px;">Inactiva</span>
                            {{/activa}}
                        </div>
                    </td>
                </tr>
                {{/asociaciones}}
                {{^asociaciones}}
                <tr>
                    <td colspan="8" style="text-align:center;padding:30px;color:#6b7280;">
                        No hay asociaciones a planes.
                        {{#activa}}<a href="/admin/materias/{{id}}/planes/nueva" style="color:#2563eb;">Agregar la primera</a>.{{/activa}}
                    </td>
                </tr>
                {{/asociaciones}}
            </tbody>
        </table>
    </div>

</div>
</body>
</html>
