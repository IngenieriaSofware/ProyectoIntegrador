<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cambiar Cargo — {{docenteNombre}}</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px; }
        .form-group select {
            width:100%; padding:10px 14px; border:1.5px solid #d1d5db; border-radius:8px;
            font-size:14px; outline:none; box-sizing:border-box;
        }
        .form-group select:focus { border-color:#2563eb; }
        .hint { font-size:11.5px; color:#6b7280; margin-top:4px; }
        .btn-primary { background:#2563eb;color:#fff;padding:10px 22px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer; }
        .btn-secondary { background:#f1f5f9;color:#374151;padding:10px 18px;border:1px solid #e2e8f0;border-radius:8px;font-size:14px;text-decoration:none;display:inline-block; }
        .info-row { display:flex;gap:8px;margin-bottom:10px;font-size:14px; }
        .info-label { font-weight:600;color:#374151;min-width:130px; }
        .info-val { color:#6b7280; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-edit-alt"></i></div>
            <div>
                <h1>Modificar Cargo</h1>
                <span class="role-badge">{{comisionNombre}}</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/admin/comisiones/{{comisionId}}" class="logout-btn">← Volver</a>
        </div>
    </div>

    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <div class="admin-section" style="max-width:480px;">
        <div class="info-row"><span class="info-label">Docente:</span><span class="info-val"><strong>{{docenteNombre}}</strong></span></div>
        <div class="info-row"><span class="info-label">Cargo actual:</span><span class="info-val">{{cargoActualLabel}}</span></div>
        <div class="info-row"><span class="info-label">Comisión:</span><span class="info-val">{{comisionNombre}}</span></div>

        <form action="/admin/comisiones/{{comisionId}}/asignaciones/{{asId}}/cargo" method="post" style="margin-top:20px;">
            <div class="form-group">
                <label for="cargo">Nuevo cargo *</label>
                <select id="cargo" name="cargo" required>
                    <option value="">— Seleccionar nuevo cargo —</option>
                    <option value="TITULAR" {{#esTitular}}disabled{{/esTitular}}>Titular</option>
                    <option value="JTP" {{#esJTP}}disabled{{/esJTP}}>JTP</option>
                    <option value="AYUDANTE" {{#esAyudante}}disabled{{/esAyudante}}>Ayudante</option>
                </select>
                <div class="hint">El cargo actual está deshabilitado. RN-05: solo un Titular por comisión.</div>
            </div>
            <div style="display:flex;gap:12px;margin-top:24px;">
                <button type="submit" class="btn-primary">Actualizar cargo</button>
                <a href="/admin/comisiones/{{comisionId}}" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
</body>
</html>
