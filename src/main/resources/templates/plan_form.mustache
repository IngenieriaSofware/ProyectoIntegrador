<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{accion}} Plan de Estudio</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px; }
        .form-group input, .form-group textarea {
            width:100%;padding:10px 14px;border:1.5px solid #d1d5db;border-radius:8px;
            font-size:14px;outline:none;transition:border-color 0.2s;
        }
        .form-group input:focus, .form-group textarea:focus { border-color:#2563eb; }
        .form-group input[readonly] { background:#f9fafb;color:#6b7280;cursor:not-allowed; }
        .form-group textarea { resize:vertical;min-height:90px; }
        .hint { font-size:11.5px;color:#6b7280;margin-top:4px; }
        .btn-primary  { background:#2563eb;color:#fff;padding:10px 22px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer; }
        .btn-secondary{ background:#f1f5f9;color:#374151;padding:10px 18px;border:1px solid #e2e8f0;border-radius:8px;font-size:14px;text-decoration:none;display:inline-block; }
        .breadcrumb { font-size:13px;color:#6b7280;margin-bottom:6px; }
        .breadcrumb a { color:#2563eb;text-decoration:none; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-calendar-alt"></i></div>
            <div>
                <h1>{{accion}} Plan de Estudio</h1>
                <span class="role-badge">{{carreraNombre}}</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/admin/carreras/{{carreraId}}" class="logout-btn">← Volver</a>
        </div>
    </div>

    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <div class="admin-section" style="max-width:520px;">
        <form action="{{formAction}}" method="post">

            <!-- Año vigencia: solo lectura en edición -->
            {{#esEdicion}}
            <div class="form-group">
                <label>Año de vigencia</label>
                <input type="text" value="{{anioVigencia}}" readonly>
                <div class="hint">El año de vigencia no puede modificarse una vez creado.</div>
            </div>
            {{/esEdicion}}

            {{^esEdicion}}
            <div class="form-group">
                <label for="anioVigencia">Año de vigencia *</label>
                <input type="number" id="anioVigencia" name="anioVigencia"
                       placeholder="Ej: 2024" min="1900" max="2031" required
                       value="{{anioVigencia}}">
                <div class="hint">Año calendario en que entra en vigor el plan. Único por carrera.</div>
            </div>
            {{/esEdicion}}

            <div class="form-group">
                <label for="duracionAnios">Duración en años (opcional)</label>
                <input type="number" id="duracionAnios" name="duracionAnios"
                       placeholder="Ej: 5" min="1" max="10"
                       value="{{duracionAnios}}">
                <div class="hint">Duración teórica del plan. Puede dejarse en blanco.</div>
            </div>

            <div class="form-group">
                <label for="descripcion">Descripción (opcional)</label>
                <textarea id="descripcion" name="descripcion"
                          placeholder="Notas o diferencias respecto a planes anteriores...">{{descripcion}}</textarea>
            </div>

            <div style="display:flex;gap:12px;align-items:center;margin-top:24px;">
                <button type="submit" class="btn-primary">{{accion}} plan</button>
                <a href="/admin/carreras/{{carreraId}}" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>

</div>
</body>
</html>
