<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .materias-container { max-width: 1000px; margin: 20px auto; padding: 0 20px; }
        .materias-header { margin-bottom: 30px; }
        .materias-section { background: #f8f9fa; border-radius: 10px; padding: 20px; margin-bottom: 20px; }
        .materia-card { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 15px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        .materia-info { flex: 1; }
        .materia-nombre { font-weight: bold; font-size: 16px; color: #333; }
        .materia-codigo { font-size: 12px; color: #666; }
        .materia-turno { font-size: 14px; color: #2563eb; margin: 5px 0; }
        .materia-inscritos { font-size: 12px; color: #999; }
        .materia-actions { display: flex; gap: 10px; align-items: center; }
        .btn-inscribir { background: #2563eb; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; }
        .btn-inscribir:hover { background: #1d4ed8; }
        .btn-inscribir:disabled { background: #ccc; cursor: not-allowed; }
        .badge-inscrito { background: #10b981; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; }
        .empty-message { text-align: center; padding: 40px; color: #666; }
        .goto-dashboard { display: inline-block; margin-top: 20px; }
    </style>
</head>
<body>
<div class="dashboard-container">

    <!-- HEADER -->
    <div class="dashboard-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-graduation-cap"></i></div>
            <div>
                <h1>Seleccionar Materias</h1>
                <span class="role-badge">Estudiante</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <div class="role-text">Sesión activa</div>
            <a href="/logout" class="logout-btn">Cerrar sesión</a>
        </div>
    </div>

    <!-- CONTENIDO -->
    <div class="materias-container">
        {{#successMessage}}
        <div class="alert alert-success" role="alert">
            <i class="uil uil-check-circle"></i> {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="alert alert-danger" role="alert">
            <i class="uil uil-exclamation-circle"></i> {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="materias-section">
            <div class="materias-header">
                <h2>Carrera: {{carrera}}</h2>
                <p style="margin: 10px 0 0; color: #666;">{{planEstudio}}</p>
                <p style="margin-top: 15px; color: #333;"><strong>Comisiones disponibles:</strong> {{totalDisponibles}}</p>
            </div>

            {{#comisiones}}
            <div class="materia-card">
                <div class="materia-info">
                    <div class="materia-codigo">{{materiaCodigo}}</div>
                    <div class="materia-nombre">{{materiaNombre}}</div>
                    <div class="materia-turno"><i class="uil uil-clock-eight"></i> {{turno}}</div>
                    <div class="materia-inscritos">Inscritos: {{inscritos}}</div>
                </div>
                <div class="materia-actions">
                    {{#yaInscripto}}
                    <span class="badge-inscrito"><i class="uil uil-check"></i> Inscripto</span>
                    {{/yaInscripto}}
                    {{^yaInscripto}}
                    <form action="/estudiante/inscribirse-comision" method="post" style="display: inline;">
                        <input type="hidden" name="comisionId" value="{{id}}">
                        <button type="submit" class="btn-inscribir"><i class="uil uil-plus"></i> Inscribirse</button>
                    </form>
                    {{/yaInscripto}}
                </div>
            </div>
            {{/comisiones}}

            {{^comisiones}}
            <div class="empty-message">
                <i class="uil uil-inbox" style="font-size: 64px; color: #ddd;"></i>
                <p style="margin-top: 20px;">No hay comisiones disponibles en este período.</p>
            </div>
            {{/comisiones}}
        </div>

        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <a href="/estudiante" class="logout-btn" style="text-decoration: none; display: inline-block;">← Volver al panel</a>
            <a href="/estudiante/mis-cursos" class="logout-btn" style="text-decoration: none; display: inline-block; background: #10b981;">Ver mis cursos →</a>
        </div>
    </div>

</div>
</body>
</html>
