<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Comisión</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .form-group { margin-bottom: 18px; }
        .form-group label { display:block; font-size:13px; font-weight:600; color:#374151; margin-bottom:6px; }
        .form-group select, .form-group input {
            width:100%; padding:10px 14px; border:1.5px solid #d1d5db; border-radius:8px;
            font-size:14px; outline:none; box-sizing:border-box;
        }
        .form-group select:focus { border-color:#2563eb; }
        .hint { font-size:11.5px; color:#6b7280; margin-top:4px; }
        .btn-primary { background:#2563eb;color:#fff;padding:10px 22px;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer; }
        .btn-secondary { background:#f1f5f9;color:#374151;padding:10px 18px;border:1px solid #e2e8f0;border-radius:8px;font-size:14px;text-decoration:none;display:inline-block; }
        .warn-box { background:#fffbeb;border:1px solid #fbbf24;color:#92400e;padding:12px 16px;border-radius:8px;margin-bottom:18px;font-size:13px; }
        .info-box { background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;padding:12px 16px;border-radius:8px;margin-bottom:18px;font-size:13px; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-users-alt"></i></div>
            <div>
                <h1>Nueva Comisión</h1>
                <span class="role-badge">Módulo C.1</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/admin/comisiones" class="logout-btn">← Volver</a>
        </div>
    </div>

    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    {{#sinPeriodoActivo}}
    <div class="warn-box">
        ⚠️ <strong>No hay un período lectivo activo configurado.</strong>
        Las comisiones se crean para el período activo.
        <a href="/admin/periodos" style="color:#92400e;font-weight:600;">Configurar períodos →</a>
    </div>
    {{/sinPeriodoActivo}}

    {{#periodoActivo}}
    <div class="info-box">
        Período activo: <strong>{{label}}</strong>. La comisión se asignará a este período.
    </div>
    {{/periodoActivo}}

    {{^sinPeriodoActivo}}
    <div class="admin-section" style="max-width:560px;">
        <form action="/admin/comisiones/nueva" method="post">

            <div class="form-group">
                <label for="materiaId">Materia *</label>
                <select id="materiaId" name="materiaId" required>
                    <option value="">— Seleccionar materia activa —</option>
                    {{#materias}}
                    <option value="{{id}}">{{displayText}}</option>
                    {{/materias}}
                </select>
            </div>

            <div class="form-group">
                <label for="planEstudioId">Plan de Estudio *</label>
                <select id="planEstudioId" name="planEstudioId" required>
                    <option value="">— Seleccionar plan activo —</option>
                    {{#planes}}
                    <option value="{{id}}">{{displayText}}</option>
                    {{/planes}}
                </select>
            </div>

            <div class="form-group">
                <label for="turno">Turno *</label>
                <select id="turno" name="turno" required>
                    <option value="">— Seleccionar —</option>
                    <option value="MANANA">Mañana</option>
                    <option value="TARDE">Tarde</option>
                    <option value="NOCHE">Noche</option>
                </select>
            </div>

            <div style="display:flex;gap:12px;margin-top:24px;">
                <button type="submit" class="btn-primary">Crear comisión</button>
                <a href="/admin/comisiones" class="btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
    {{/sinPeriodoActivo}}
</div>
</body>
</html>
