<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Control</title>
    <link rel="stylesheet" href="/css/login-style.css" />
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css" />
    <style>
        .dashboard_container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .dashboard_section {
            border-top: 2px solid #5ea3d0;
            padding-top: 1rem;
        }

        .dashboard_section h3 {
            font-size: 1rem;
            margin-bottom: 1rem;
            color: #333;
        }

        .options_grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 0.75rem;
        }

        .logout_section {
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #ddd;
        }

        @media (max-width: 480px) {
            .options_grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <section class="home">
        <div class="form_container">
            <div class="form login_form">
                <h2>Panel de Control</h2>
                <p>Bienvenido, {{username}}!</p>

                <div class="dashboard_container">
                    {{#isAdmin}}
                    <div class="dashboard_section">
                        <h3>Administración</h3>
                        <div class="options_grid">
                            <a href="/user/create" class="button">Crear Usuario</a>
                            <a href="/professor/list" class="button">Gestionar Profesores</a>
                        </div>
                    </div>
                    {{/isAdmin}}

                    {{#isDocente}}
                    <div class="dashboard_section">
                        <h3>Profesores</h3>
                        <div class="options_grid">
                            <a href="/professor/new" class="button">Crear Profesor</a>
                            <a href="/professor/list" class="button">Listar Profesores</a>
                        </div>
                    </div>
                    {{/isDocente}}

                    {{#isEstudiante}}
                    <div class="dashboard_section">
                        <h3>Mis Espacios</h3>
                        <div class="options_grid">
                            <a href="/mis-cursos" class="button">Mis Cursos</a>
                            <a href="/perfil" class="button">Ver Perfil</a>
                        </div>
                    </div>
                    {{/isEstudiante}}

                    <div class="logout_section">
                        <a href="/logout" class="button">Cerrar Sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
