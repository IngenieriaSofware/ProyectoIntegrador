<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Materias — Panel Administrativo</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .badge-activa   { background:#d1fae5;color:#065f46;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .badge-inactiva { background:#fee2e2;color:#991b1b;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        select.filter-select { padding:7px 12px;border:1.5px solid #d1d5db;border-radius:8px;font-size:13px;background:#fff; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-book-open"></i></div>
            <div>
                <h1>Gestión de Materias</h1>
                <span class="role-badge">Módulo B.2 — Oferta Académica</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <div class="role-text">Administrador</div>
            <a href="/admin" class="logout-btn">← Panel</a>
        </div>
    </div>

    {{#successMessage}}
    <div style="background:#d1fae5;color:#065f46;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{successMessage}}</div>
    {{/successMessage}}
    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <!-- Filtros -->
    <div class="admin-section" style="padding:14px 18px;">
        <form method="get" action="/admin/materias" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
            <select name="carreraId" class="filter-select" onchange="this.form.submit()">
                <option value="">Todas las carreras</option>
                {{#carreras}}
                <option value="{{id}}">{{nombre}}</option>
                {{/carreras}}
            </select>
            <select name="planId" class="filter-select" onchange="this.form.submit()">
                <option value="">Todos los planes</option>
                {{#planes}}
                <option value="{{id}}">{{displayText}}</option>
                {{/planes}}
            </select>
            <a href="/admin/materias" style="font-size:13px;color:#6b7280;text-decoration:none;">Limpiar filtros</a>
        </form>
    </div>

    <div class="admin-section">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <p class="section-title" style="margin:0;">Materias ({{totalMaterias}} en total)</p>
            <a href="/admin/materias/nueva" class="action-btn"
               style="background:#2563eb;color:#fff;padding:9px 18px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;">
                + Nueva Materia
            </a>
        </div>

        <table class="styled-table" style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Código</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Nombre</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Planes activos</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Estado</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#materias}}
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:10px 14px;font-weight:600;color:#2563eb;">{{codigo}}</td>
                    <td style="padding:10px 14px;">{{nombre}}</td>
                    <td style="padding:10px 14px;color:#6b7280;font-size:13px;">{{planesCount}}</td>
                    <td style="padding:10px 14px;">
                        {{#activa}}<span class="badge-activa">Activa</span>{{/activa}}
                        {{^activa}}<span class="badge-inactiva">Inactiva</span>{{/activa}}
                    </td>
                    <td style="padding:10px 14px;">
                        <a href="/admin/materias/{{id}}" style="color:#2563eb;text-decoration:none;font-size:13px;">Ver detalle</a>
                    </td>
                </tr>
                {{/materias}}
            </tbody>
        </table>

        {{^materias}}
        <div style="text-align:center;padding:40px;color:#6b7280;">
            No hay materias registradas.
            <a href="/admin/materias/nueva" style="color:#2563eb;">Crear la primera</a>.
        </div>
        {{/materias}}

        <div class="pagination" style="display:flex;gap:6px;margin-top:20px;justify-content:center;">
            <a href="/admin/materias?page={{previousPage}}" class="{{^hasPrevious}}disabled{{/hasPrevious}}"
               style="padding:6px 12px;border-radius:6px;border:1px solid #e2e8f0;text-decoration:none;color:#374151;font-size:13px;">
                &laquo; Anterior
            </a>
            {{#pages}}
            <a href="/admin/materias?page={{number}}"
               style="padding:6px 12px;border-radius:6px;border:1px solid #e2e8f0;text-decoration:none;font-size:13px;{{#isCurrent}}background:#2563eb;color:#fff;{{/isCurrent}}{{^isCurrent}}color:#374151;{{/isCurrent}}">
                {{number}}
            </a>
            {{/pages}}
            <a href="/admin/materias?page={{nextPage}}" class="{{^hasNext}}disabled{{/hasNext}}"
               style="padding:6px 12px;border-radius:6px;border:1px solid #e2e8f0;text-decoration:none;color:#374151;font-size:13px;">
                Siguiente &raquo;
            </a>
        </div>
    </div>

</div>
</body>
</html>
