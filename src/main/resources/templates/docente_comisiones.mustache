<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Comisiones — Panel Docente</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .badge-titular  { background:#dbeafe;color:#1e40af;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .badge-jtp      { background:#fef3c7;color:#92400e;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .badge-ayudante { background:#f3f4f6;color:#374151;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .perm-ok  { color:#059669;font-size:12px; }
        .perm-no  { color:#9ca3af;font-size:12px; }
    </style>
</head>
<body>
<div class="dashboard-container">

    <div class="dashboard-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-book-reader"></i></div>
            <div>
                <h1>Mis Comisiones</h1>
                <span class="role-badge">Período activo</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/docente" class="logout-btn">← Panel</a>
        </div>
    </div>

    {{#sinComisiones}}
    <div class="dashboard-section">
        <div style="text-align:center;padding:50px;color:#6b7280;">
            <i class="uil uil-info-circle" style="font-size:40px;display:block;margin-bottom:12px;"></i>
            No tenés comisiones asignadas en el período lectivo activo.
        </div>
    </div>
    {{/sinComisiones}}

    {{^sinComisiones}}
    <div class="dashboard-section">
        <p class="section-title">Comisiones asignadas — {{periodoLabel}}</p>
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Materia</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Plan</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Turno</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Cargo</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Cargar notas</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;font-size:13px;">Cerrar acta</th>
                </tr>
            </thead>
            <tbody>
                {{#comisiones}}
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:10px 14px;">
                        <strong>{{materiaCodigo}}</strong> {{materiaNombre}}
                    </td>
                    <td style="padding:10px 14px;color:#6b7280;font-size:13px;">Plan {{anioVigencia}}</td>
                    <td style="padding:10px 14px;color:#6b7280;font-size:13px;">{{turnoLabel}}</td>
                    <td style="padding:10px 14px;">
                        <span class="badge-{{cargoLabel}}">{{cargoLabel}}</span>
                    </td>
                    <td style="padding:10px 14px;">
                        {{#puedeCargarNotas}}<span class="perm-ok">✓ Sí</span>{{/puedeCargarNotas}}
                        {{^puedeCargarNotas}}<span class="perm-no">✗ No</span>{{/puedeCargarNotas}}
                    </td>
                    <td style="padding:10px 14px;">
                        {{#puedeCerrarActa}}<span class="perm-ok">✓ Sí</span>{{/puedeCerrarActa}}
                        {{^puedeCerrarActa}}<span class="perm-no">✗ No</span>{{/puedeCerrarActa}}
                    </td>
                </tr>
                {{/comisiones}}
            </tbody>
        </table>
        <p style="font-size:12px;color:#9ca3af;margin-top:12px;">
            Solo lectura — las asignaciones son gestionadas por el administrador (RN-13).
        </p>
    </div>
    {{/sinComisiones}}

</div>
</body>
</html>
