<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actas de Calificaciones</title>
    <link rel="stylesheet" href="/css/login-style.css">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
    <link rel="stylesheet" href="/css/style-dashboard.css">
    <style>
        .badge-abierta  { background:#d1fae5;color:#065f46;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        .badge-cerrada  { background:#fee2e2;color:#991b1b;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600; }
        select.filter-select { padding:7px 12px;border:1.5px solid #d1d5db;border-radius:8px;font-size:13px;background:#fff; }
    </style>
</head>
<body>
<div class="admin-container">

    <div class="admin-header">
        <div class="header-left">
            <div class="header-icon"><i class="uil uil-file-alt"></i></div>
            <div>
                <h1>Actas de Calificaciones</h1>
                <span class="role-badge">Módulo D.2 — Gestión de Actas</span>
            </div>
        </div>
        <div class="user-info">
            <div class="email">{{email}}</div>
            <a href="/docente" class="logout-btn">← Panel</a>
        </div>
    </div>

    {{#successMessage}}
    <div style="background:#d1fae5;color:#065f46;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{successMessage}}</div>
    {{/successMessage}}
    {{#errorMessage}}
    <div style="background:#fee2e2;color:#991b1b;padding:12px 18px;border-radius:8px;margin-bottom:16px;">{{errorMessage}}</div>
    {{/errorMessage}}

    <!-- Filtros -->
    <div class="admin-section" style="padding:14px 18px;">
        <form method="get" action="/docente/actas" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
            <select name="comision_id" class="filter-select" onchange="this.form.submit()">
                <option value="">Todas las comisiones</option>
                {{#comisiones}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{codigo}} — {{nombre}}</option>
                {{/comisiones}}
            </select>
            <select name="estado" class="filter-select" onchange="this.form.submit()">
                <option value="">Todos los estados</option>
                <option value="abierta" {{#filtroEsAbierta}}selected{{/filtroEsAbierta}}>Abiertas</option>
                <option value="cerrada" {{#filtroEsCerrada}}selected{{/filtroEsCerrada}}>Cerradas</option>
            </select>
            <select name="instancia" class="filter-select" onchange="this.form.submit()">
                <option value="">Todas las instancias</option>
                {{#instancias}}
                <option value="{{valor}}">{{label}}</option>
                {{/instancias}}
            </select>
            <a href="/docente/actas" style="font-size:13px;color:#6b7280;text-decoration:none;">Limpiar filtros</a>
        </form>
    </div>

    <div class="admin-section">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <p class="section-title" style="margin:0;">Actas ({{totalActas}})</p>
            <a href="/docente/actas/nueva"
               style="background:#2563eb;color:#fff;padding:9px 18px;border-radius:8px;text-decoration:none;font-size:14px;font-weight:600;">
                + Nueva Acta
            </a>
        </div>

        <table class="styled-table" style="width:100%;border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Comisión</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Período</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Instancia</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Notas</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Estado</th>
                    <th style="text-align:left;padding:10px 14px;background:#f1f5f9;border-bottom:2px solid #e2e8f0;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {{#actas}}
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:10px 14px;font-weight:600;">{{materiaCodigo}} — {{materiaNombre}}</td>
                    <td style="padding:10px 14px;color:#6b7280;font-size:13px;">{{periodoLabel}}</td>
                    <td style="padding:10px 14px;color:#374151;font-size:13px;">{{instanciaLabel}}</td>
                    <td style="padding:10px 14px;color:#6b7280;font-size:13px;">{{notasCargadas}} / {{totalNotas}}</td>
                    <td style="padding:10px 14px;">
                        {{#abierta}}<span class="badge-abierta">Abierta</span>{{/abierta}}
                        {{#cerrada}}<span class="badge-cerrada">Cerrada</span>{{/cerrada}}
                    </td>
                    <td style="padding:10px 14px;">
                        <a href="/docente/actas/{{id}}" style="color:#2563eb;text-decoration:none;font-size:13px;">Ver / Cargar</a>
                    </td>
                </tr>
                {{/actas}}
            </tbody>
        </table>

        {{^actas}}
        <div style="text-align:center;padding:40px;color:#6b7280;">
            No hay actas para los filtros seleccionados.
            <a href="/docente/actas/nueva" style="color:#2563eb;">Crear la primera</a>.
        </div>
        {{/actas}}
    </div>
</div>
</body>
</html>
